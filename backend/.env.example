# Azure OpenAI resource endpoint (not a deployment URL).
# Copy the exact value from Azure Portal > signal-openai-poc > Keys and Endpoint.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/

# Paste your key locally. Never commit this file or put the key in the frontend.
AZURE_OPENAI_API_KEY=PASTE_YOUR_AZURE_OPENAI_KEY_HERE

# Existing deployment names confirmed in Microsoft Foundry.
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=signal-embeddings

# Embedding dimension to request when building the local document index.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Allowed local frontend origins, as a JSON array.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
